# Applied over `make allnoconfig`'s "everything off" baseline (see the
# top-level Makefile's busybox/.config rule, which sed's each "CONFIG_X=y"
# line below into busybox/.config in place of its allnoconfig-generated
# "# CONFIG_X is not set" -- busybox's own Kconfig fork doesn't honor
# KCONFIG_ALLCONFIG's override values the way upstream Linux Kbuild does,
# so that more obvious approach silently no-ops instead), then finished
# off with `oldconfig` to resolve whatever dependent prompts those
# selections newly expose. Everything not named here (or pulled in as a
# Kconfig dependency of something that is) stays off. This is
# deliberately small and curated rather than a full defconfig: PoC-OS has
# no /proc, no networking, no loadable modules, no multi-user
# permissions/passwd database, and no real process-group job control
# (console.c tracks a single foreground pid -- see its own doc comment),
# so whole applet families (mount/insmod/ps/top/ip/ping/udhcpc/syslog/
# login/su/crond/...) are left off rather than built just to abort at
# runtime the first time something calls a syscall this kernel doesn't
# implement (see toolchain/mlibc-sysdeps-pocos/sysdeps.cpp and
# tools/gen_mlibc_stubs.py's STUB()).
#
# A symbol name here that busybox's Kconfig doesn't recognize (e.g. if a
# future busybox release renames something) is silently a no-op -- the
# sed simply finds nothing to replace. If an applet you expected is
# missing from `busybox --list` after a rebuild, check busybox/.config
# directly against busybox/*/Config.in for the current symbol name.

CONFIG_DESKTOP=y
CONFIG_LFS=y

# Dynamic linking (see the top-level Makefile's busybox/busybox rule,
# which links against toolchain/sysroot-shared/'s libc.so/ld.so) --
# CONFIG_STATIC is the inverse of what we want, so explicitly off.
CONFIG_STATIC=n
CONFIG_PIE=y

# busybox's own default (/proc/self/exe) is how a non-NOFORK applet
# invoked under standalone-shell mode re-execs itself in a forked child
# (see shell/Config.src's FEATURE_SH_STANDALONE help text) -- this
# kernel has no /proc at all, so that path never resolves and every
# such applet call fails execve() (surfaced as ash's generic "Exec
# format error", since sysdeps.cpp's Sysdeps<Execve> hard-codes ENOEXEC
# for any SYS_EXECVE failure regardless of cause -- see its own doc
# comment). /busybox itself (disk.img's actual install path -- see the
# top-level Makefile's disk.img rule) always exists and is exactly the
# same binary, so pointing this at the real path fixes every applet that
# isn't NOFORK-safe.
CONFIG_BUSYBOX_EXEC_PATH="/busybox"

# --- ash: the only shell we build, aliased to the "sh" applet name
# (kernel/src/main.c's spawn_boot_program("/busybox", "sh") relies on
# this), with standalone-shell support so ash calls every other applet
# below as a direct in-process built-in instead of exec()ing a separate
# file -- fat32.c has no symlink support (see fat32.h's doc comment), so
# there are no per-applet files/symlinks on disk.img at all, only this
# one binary. Job control (ASH_JOB_CONTROL, bg/fg/jobs/^Z) is left off:
# this kernel has no real process groups, only console.c's single
# foreground-pid concept.
CONFIG_SH_IS_ASH=y
CONFIG_ASH=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_SH_NOFORK=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_CMDCMD=y
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_ASH_RANDOM_SUPPORT=y

# --- coreutils: the file/text utilities that only need what
# kernel/src/syscall.h already implements (read/write/open/close/lseek/
# fstat/getdents/unlink/rmdir/rename/mkdir/getcwd/chdir).
CONFIG_CAT=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_RMDIR=y
CONFIG_MKDIR=y
CONFIG_TOUCH=y
CONFIG_LS=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_RECURSIVE=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_PWD=y
CONFIG_ECHO=y
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_PRINTF=y
CONFIG_TEST=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_SLEEP=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_WC=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_CUT=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_TR=y
CONFIG_ENV=y
CONFIG_YES=y
CONFIG_SEQ=y
CONFIG_DU=y
CONFIG_LN=n

# --- editors/text search: pure userspace once a file's open, no extra
# syscalls beyond the coreutils set above.
CONFIG_SED=y
CONFIG_GREP=y
CONFIG_EGREP=y

# --- findutils: exercises the new SYS_GETDENTS-backed opendir/readdir
# path end to end (see kernel/src/fat32.c's fat32_readdir()).
CONFIG_FIND=y
CONFIG_WHICH=y

# --- misc/console-tools
CONFIG_CLEAR=y
CONFIG_RESET=y
