# Meson cross-file for building mlibc against PoC-OS as a *shared* libc
# (libc.so + ld.so) instead of the static libc.a toolchain/pocos.cross-file
# produces -- see the top-level Makefile's mlibc-sysroot-shared target and
# kernel/src/elf.c's PT_INTERP support. Identical to pocos.cross-file in
# every other respect (see its own doc comment for the reasoning behind
# clang-as-cross-compiler, LLVM ar/ranlib, and -D_GNU_SOURCE); the only
# difference is dropping -fno-pic/-fno-pie in favor of -fPIC, since both
# libc.so itself and the dynamic linker (ld.so, itself an ET_DYN loaded at
# a load-time-chosen base -- see mlibc/options/rtld) must be position-
# independent code. A PIE main executable built against this sysroot
# needs its own explicit -fPIE/-pie at compile/link time (see the
# userland/%.dyn.elf Makefile rule) -- this cross-file only governs how
# mlibc itself gets built.
#
# c_link_args/cpp_link_args: unlike the static cross-file (which never
# actually links -- static_library() targets only archive .o files via
# ar/ranlib), building libc.so/ld.so exercises a real `-shared` link, and
# clang's driver -- Apple's /usr/bin/clang *and* Homebrew's own full
# build, verified directly, so this isn't an Apple-clang-specific
# limitation -- has no proper linker Job for an `-shared` link against
# the bare-metal `x86_64-unknown-none-elf` target on a Darwin host: it
# silently shells out to a plain `/usr/bin/gcc` subprocess *without*
# forwarding -target at all, which then defaults to linking a macOS
# dylib (`ld.lld: error: unknown argument '-dynamic'/'-dylib'/'-arch'...`
# -- genuine Darwin linker flags, not ELF ones). Compiling (.c/.cpp ->
# .o) is entirely unaffected -- only the final link Job selection is
# broken. Overriding just `-target` to `x86_64-linux-gnu` for the link
# step alone (via *_link_args, appended after the base `x86_64-unknown-
# none-elf` from c/cpp below -- clang's driver uses whichever -target it
# sees last) routes through clang's mature Linux toolchain instead, which
# calls the given `-fuse-ld=` linker directly with correct `-m
# elf_x86_64` GNU-style flags. This produces identical machine code to
# the real target (no new codegen happens at link time, only object
# files already compiled against the real target get concatenated) and
# doesn't touch compilation, so it's safe despite the mismatched triple
# name -- verified with a standalone `-shared` link before wiring this
# in. `ld.lld`'s full path (a separate Homebrew `lld` formula, not the
# `llvm` formula's bin/ -- verified this is what's actually on PATH and
# what the top-level Makefile's own manual `ld.lld -m elf_x86_64 ...`
# invocations already use) avoids a second, unrelated flavor-ambiguity
# bug where a bare `-fuse-ld=lld` resolves to the Mach-O `ld64.lld`
# personality instead.
[binaries]
c = ['/usr/bin/clang', '-target', 'x86_64-unknown-none-elf', '-ffreestanding', '-fPIC', '-m64', '-march=x86-64', '-D_GNU_SOURCE']
cpp = ['/usr/bin/clang++', '-target', 'x86_64-unknown-none-elf', '-ffreestanding', '-fPIC', '-fno-exceptions', '-fno-rtti', '-m64', '-march=x86-64', '-D_GNU_SOURCE']
ar = '/usr/local/opt/llvm/bin/llvm-ar'
ranlib = '/usr/local/opt/llvm/bin/llvm-ranlib'

[built-in options]
c_link_args = ['-fuse-ld=/usr/local/bin/ld.lld', '-target', 'x86_64-linux-gnu']
cpp_link_args = ['-fuse-ld=/usr/local/bin/ld.lld', '-target', 'x86_64-linux-gnu']

[properties]
needs_exe_wrapper = true

[host_machine]
system = 'pocos'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'
