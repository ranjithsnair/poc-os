# Meson cross-file for building mlibc against PoC-OS. Unlike a normal
# OS port (which would use a pre-built cross GCC targeting a real triple
# like x86_64-managarm), this uses clang's generic
# `-target x86_64-unknown-none-elf` the same way kernel/Makefile already
# does for the kernel itself -- no cross-binutils/GCC bootstrap needed
# just to build mlibc, since clang alone is a complete, working
# cross-compiler for freestanding x86-64 ELF. See toolchain/README (or
# the plan) for why an actual cross GCC still gets built later anyway
# (bash needs to be built with *something* that isn't clang, per the
# original ask).
#
# ar/ranlib must be LLVM's: macOS's native `ar`/`ranlib` don't understand
# ELF object files at all (verified directly -- `ranlib` on a
# clang-produced ELF .o reports "the table of contents is empty", since
# it can't parse ELF symbol tables), which would silently produce a
# static library with no usable symbol index.
# -D_GNU_SOURCE: mlibc's own internal implementation files (e.g.
# options/posix/generic/dlfcn.cpp's dladdr(), grp.cpp's getgrouplist())
# reference declarations that mlibc-config.h.in's own self-contained
# feature-test-macro cascade only exposes once _POSIX_C_SOURCE reaches
# 202405L -- which defining _GNU_SOURCE triggers internally (see that
# file). Without this, those two files fail to compile with "unknown
# type Dl_info" / "undeclared identifier getgrouplist" even though mlibc
# itself both declares and implements them -- nothing to do with our own
# sysdeps, which is why this lives here rather than in any tag we own.
[binaries]
c = ['/usr/bin/clang', '-target', 'x86_64-unknown-none-elf', '-ffreestanding', '-fno-pic', '-fno-pie', '-m64', '-march=x86-64', '-D_GNU_SOURCE']
cpp = ['/usr/bin/clang++', '-target', 'x86_64-unknown-none-elf', '-ffreestanding', '-fno-pic', '-fno-pie', '-fno-exceptions', '-fno-rtti', '-m64', '-march=x86-64', '-D_GNU_SOURCE']
ar = '/usr/local/opt/llvm/bin/llvm-ar'
ranlib = '/usr/local/opt/llvm/bin/llvm-ranlib'
c_ld = 'lld'
cpp_ld = 'lld'

[properties]
needs_exe_wrapper = true

[host_machine]
system = 'pocos'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'
